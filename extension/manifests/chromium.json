{
  "manifest_version": 3,
  "name": "lull",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "lull" },
  "permissions": ["tabs", "tabGroups", "idle", "nativeMessaging", "alarms"],
  "host_permissions": [
    "http://localhost/*", "https://localhost/*",
    "http://127.0.0.1/*", "https://127.0.0.1/*",
    "http://[::1]/*", "https://[::1]/*",
    "http://*.localhost/*", "https://*.localhost/*"
  ],
  "content_scripts": [{
    "matches": [
      "http://localhost/*", "https://localhost/*",
      "http://127.0.0.1/*", "https://127.0.0.1/*",
      "http://[::1]/*", "https://[::1]/*",
      "http://*.localhost/*", "https://*.localhost/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
